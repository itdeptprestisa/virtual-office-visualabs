# Untuk docker-compose.yml (produksi / Dokploy). Salin jadi .env, atau isi di tab Environment Dokploy.

# Domain (tanpa https://), semua diarahkan ke IP server (Cloudflare: DNS-only / grey cloud).
# Routing & HTTPS lewat label Traefik di docker-compose.yml — tab Domains Dokploy tidak perlu diisi.
APP_DOMAIN=visualabs.prestisa.id
LIVEKIT_DOMAIN=livekit-visualabs.prestisa.id
# Harus beda dari LIVEKIT_DOMAIN.
TURN_DOMAIN=turn-visualabs.prestisa.id

# Opsional — prefix nama router Traefik & port publik LiveKit. Wajib unik per instance di server yang sama.
# Bawaan di bawah = Visualabs (play.prestisa.com memakai router "office-turn" dan port 7881/7882/3478).
ROUTER_PREFIX=visualabs
RTC_TCP_PORT=17881
RTC_UDP_PORT=17882
TURN_UDP_PORT=13478

# Kunci sendiri — JANGAN pakai devkey/secret. Buat dengan:
#   echo "API$(openssl rand -hex 6)"   → LIVEKIT_API_KEY
#   openssl rand -hex 32              → LIVEKIT_API_SECRET (minimal 32 karakter)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# true = LiveKit mencari IP publik server sendiri (wajib di VPS). false hanya untuk tes di jaringan lokal.
LIVEKIT_EXTERNAL_IP=true
